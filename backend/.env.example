# =============================================================
# Configurações de Ambiente — Help Desk System
# Copie este arquivo para .env e preencha os valores reais
# NUNCA versione o arquivo .env no Git!
# =============================================================

# --- Banco de Dados ---
# Formato: postgresql://usuario:senha@host:porta/nome_banco
DATABASE_URL=postgresql://postgres.kknviqnqylewbnvtrdfa:[SUA SENHA].@aws-1-sa-east-1.pooler.supabase.com:5432/postgres


# --- Segurança JWT ---
# Chave secreta para assinar os tokens (gere uma aleatória e longa!)
# Gerar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE_POR_UMA_CHAVE_SECRETA_LONGA_E_ALEATORIA
ALGORITHM=HS256

# Tempo de expiração do token de acesso (em minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Servidor ---
HOST=0.0.0.0
PORT=8000
DEBUG=True

# --- Upload de Arquivos ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,txt,doc,docx

# --- Aplicação ---
APP_NAME=Help Desk System
APP_VERSION=1.0.0

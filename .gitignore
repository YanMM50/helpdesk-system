# =============================================================
# .gitignore — Arquivos que NÃO devem ir para o Git
# =============================================================

# NUNCA versionar arquivos com credenciais!
.env
*.env

# Ambiente virtual Python
venv/
env/
.venv/

# Cache do Python
__pycache__/
*.py[cod]
*.pyo
*.pyc
.pytest_cache/

# Uploads de usuários (dados dos clientes)
backend/uploads/

# IDEs e editores
.vscode/
.idea/
*.swp
*.swo

# Sistema operacional
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Distribuição Python
*.egg-info/
dist/
build/
